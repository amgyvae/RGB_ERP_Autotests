# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# В GitHub Actions те же имена задаются в Settings -> Secrets and variables -> Actions.

# --- Тестовые аккаунты портала testportal.rgbgroup.kz ---
# Аккаунт 1 — Основной создатель документов
RGB_ACCOUNT1_LOGIN=
RGB_ACCOUNT1_PASSWORD=
RGB_ACCOUNT1_PASSWORD_ALT=

# Аккаунт 2 — Согласующий / подписант (Ерлан Талгатович)
RGB_ACCOUNT2_LOGIN=
RGB_ACCOUNT2_PASSWORD=

# Аккаунт 3 — Утверждающий / подписант (Талгат Ерланович)
RGB_ACCOUNT3_LOGIN=
RGB_ACCOUNT3_PASSWORD=

# --- Ключи ЭЦП (NCALayer, Windows) ---
# Ключ 1 (для Аккаунта 2)
NCA_KEY1_PASSWORD=
NCA_KEY1_PATH=C:\Program Files\NCALayer\GOST2015_13-02-2026-18_04.p12

# Ключ 2 (для Аккаунта 3)
NCA_KEY2_PASSWORD=
NCA_KEY2_PATH=C:\Program Files\NCALayer\GOST512_b2c2008a1d14dd3f6a531597fb334afc4b3c6e76.p12

# --- Telegram-отчёты ---
TG_ENABLED=1
TG_TOKEN=
# ID чатов через запятую
TG_CHATS=

# --- Google Sheets (чек-лист) ---
GOOGLE_SPREADSHEET_ID=
# Путь к JSON-ключу сервисного аккаунта (локально)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ИЛИ всё содержимое JSON-ключа одной строкой (для GitHub Secrets)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Браузер ---
# 1 — Chrome без окна (CI/сервер), 0 — с окном (нужно для NCALayer)
HEADLESS=0

# --- Поиск согласующих в ERP (по умолчанию 'Бейсембаев') ---
# RGB_APPROVER_QUERY=Бейсембаев
# RGB_UTV_QUERY=Алд

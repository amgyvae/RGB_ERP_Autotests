# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# В GitHub Actions те же имена задаются в Settings -> Secrets and variables -> Actions.

# --- Тестовые аккаунты портала testportal.rgbgroup.kz ---
# Аккаунт 1 — создатель документов (договоры, счета, акты, ГПР)
RGB_ACCOUNT1_LOGIN=
RGB_ACCOUNT1_PASSWORD=
# Альтернативный пароль аккаунта 1 (используется в Актах, ГПР, Финансах, Смете, Контактах)
RGB_ACCOUNT1_PASSWORD_ALT=
# Аккаунт 2 — согласующий / подписант
RGB_ACCOUNT2_LOGIN=
RGB_ACCOUNT2_PASSWORD=
# Аккаунт 3 — ДДС, сметы, паспорт проектов
RGB_ACCOUNT3_LOGIN=
RGB_ACCOUNT3_PASSWORD=

# --- Пароли ключей ЭЦП (NCALayer, только Windows) ---
NCA_KEY1_PASSWORD=
NCA_KEY2_PASSWORD=

# --- Telegram-отчёты ---
TG_ENABLED=1
TG_TOKEN=
# ID чатов через запятую
TG_CHATS=

# --- Google Sheets (чек-лист) ---
GOOGLE_SPREADSHEET_ID=
# Путь к JSON-ключу сервисного аккаунта (локально)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ИЛИ всё содержимое JSON-ключа одной строкой (удобно для CI)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Браузер ---
# 1 — Chrome без окна (CI/сервер), 0 — с окном (нужно для NCALayer)
HEADLESS=0
